<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx" xmlns:fx="http://javafx.com/fxml" fx:id="loginRoot" fx:controller="com.gearmind.presentation.controller.LoginController">
    <children>

        <ImageView preserveRatio="false" opacity="0.55" fitWidth="${loginRoot.width}" fitHeight="${loginRoot.height}">
            <image>
                <Image url="@../img/Imagen_fondo.png"/>
            </image>
        </ImageView>

        <VBox alignment="CENTER">
            <children>
                <VBox maxWidth="420" spacing="18" styleClass="tfx-card">

                    <VBox alignment="CENTER" spacing="6">
                        <ImageView fitWidth="160" fitHeight="160" preserveRatio="true">
                            <image>
                                <Image url="@../img/Logo_Gearmind.png"/>
                            </image>
                        </ImageView>
                        <Label text="GearMind Taller" styleClass="tfx-title-xl"/>
                        <Label text="Gestión de taller" styleClass="tfx-subtitle"/>
                    </VBox>

                    <VBox spacing="10">
                        <Label text="USUARIO"/>
                        <TextField fx:id="usernameField" promptText="Usuario"/>

                        <Label text="CONTRASEÑA"/>
                        <PasswordField fx:id="passwordField" promptText="Contraseña"/>
                    </VBox>

                    <HBox alignment="CENTER_RIGHT" spacing="12">
                        <Hyperlink fx:id="forgotPasswordLink" text="He olvidado la contraseña" onAction="#onForgotPassword"/>
                        <Button fx:id="loginButton" text="Entrar" onAction="#onLogin" styleClass="tfx-btn-primary"/>
                    </HBox>

                </VBox>
            </children>
        </VBox>
    </children>
</StackPane>
