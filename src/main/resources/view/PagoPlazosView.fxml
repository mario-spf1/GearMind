<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.gearmind.presentation.controller.PagoPlazosController"
      spacing="12"
      styleClass="tfx-page">

    <children>
        <Label text="Gestionar pago" styleClass="tfx-title-xl"/>
        <VBox styleClass="tfx-card" spacing="8">
            <children>
                <GridPane hgap="10" vgap="8">
                    <padding>
                        <Insets top="5" right="5" bottom="5" left="5"/>
                    </padding>
                    <columnConstraints>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                        <ColumnConstraints percentWidth="25"/>
                    </columnConstraints>
                    <children>
                        <Label text="Factura:" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                        <Label fx:id="lblFactura" text="-" GridPane.rowIndex="0" GridPane.columnIndex="1"/>
                        <Label text="Cliente:" GridPane.rowIndex="0" GridPane.columnIndex="2"/>
                        <Label fx:id="lblCliente" text="-" GridPane.rowIndex="0" GridPane.columnIndex="3"/>
                        <Label text="Tipo:" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                        <Label fx:id="lblTipo" text="-" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                        <Label text="Estado:" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                        <Label fx:id="lblEstado" text="-" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
                        <Label text="Total:" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                        <Label fx:id="lblTotal" text="0,00" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                        <Label text="Pagado:" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                        <Label fx:id="lblPagado" text="0,00" GridPane.rowIndex="2" GridPane.columnIndex="3"/>
                        <Label text="Pendiente:" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                        <Label fx:id="lblPendiente" text="0,00" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                        <Label text="Plazos:" GridPane.rowIndex="3" GridPane.columnIndex="2"/>
                        <Label fx:id="lblPlazos" text="-" GridPane.rowIndex="3" GridPane.columnIndex="3"/>
                        <Label text="Interés:" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                        <Label fx:id="lblInteres" text="0 %" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                    </children>
                </GridPane>
            </children>
        </VBox>
        <VBox styleClass="tfx-card" spacing="8">
            <children>
                <Label text="Plazos" styleClass="tfx-title"/>
                <TableView fx:id="tblPlazos">
                    <columns>
                        <TableColumn fx:id="colNumero" text="#" prefWidth="60"/>
                        <TableColumn fx:id="colVencimiento" text="Vencimiento" prefWidth="140"/>
                        <TableColumn fx:id="colImporte" text="Importe" prefWidth="120"/>
                        <TableColumn fx:id="colEstado" text="Estado" prefWidth="120"/>
                        <TableColumn fx:id="colFechaPago" text="Fecha pago" prefWidth="140"/>
                        <TableColumn fx:id="colAcciones" text="Acciones" prefWidth="140"/>
                    </columns>
                </TableView>
            </children>
        </VBox>
        <VBox styleClass="tfx-card" spacing="8">
            <children>
                <Label text="Registros de pago" styleClass="tfx-title"/>
                <TableView fx:id="tblRegistros">
                    <columns>
                        <TableColumn fx:id="colRegistroFecha" text="Fecha" prefWidth="140"/>
                        <TableColumn fx:id="colRegistroImporte" text="Importe" prefWidth="120"/>
                        <TableColumn fx:id="colRegistroObs" text="Observaciones"/>
                    </columns>
                </TableView>
            </children>
        </VBox>
        <HBox spacing="8">
            <children>
                <Region HBox.hgrow="ALWAYS"/>
                <Button text="Cerrar" onAction="#onCerrar" styleClass="tfx-btn-primary"/>
            </children>
        </HBox>
    </children>
</VBox>
